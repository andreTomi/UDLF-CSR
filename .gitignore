# Datasets are large external corpora (aloi, vegfru, sun397, ...): they are
# downloaded/extracted locally and must never be committed.
# NOTE: do not use a bare "data/" pattern here -- core.ignorecase=true makes it
# match the tracked Data/ tree as well.
Datasets/

# Build artifacts
Source/obj/
Source/bin/
*.o
*.a
*.so
*.exe
*.lftmp

# Python
__pycache__/
*.pyc

# Scratch/diagnostic output from the phase-profiling runs
Data/phase_profile/etapa_a/_diag*.txt

# Stray nohup captures from background campaign runs
nohup.out

# Binary ranked-list references written by the step-1 bit-exactness gate
# (~100 MB each; the .log checksums are the durable artifact)
Data/phase_profile/bfstree_step1/*.bin
# Goldens do A5 (mesma razao: regenerados pelo `ref`; os logs sao o artefato)
Data/phase_profile/bfstree_a5/*.bin
# Fase 0 fast-mode: derived rk / u32 sinks are large and regenerable; the
# summary.csv / parity.csv / determinism.csv / regime_ck.csv + logs are the
# durable evidence and ARE tracked.
Data/phase_profile/rfe_fast/work/


