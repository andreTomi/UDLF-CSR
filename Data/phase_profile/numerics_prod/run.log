PROD contem -DNDEBUG: sim  # as assert exatas do codigo moram aqui
NFM sem as tres flags de fast-math: verificado no preambulo
BENCH = flags de Source/tests/run_all.sh: '-std=gnu++2b -O2 -fopenmp'
